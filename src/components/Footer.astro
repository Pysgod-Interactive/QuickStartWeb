---
import { pysgodMark } from "../lib/pysgod-mark";

const year = new Date().getFullYear();
const pysgodMarkMuted = pysgodMark("#9c9488");
---

<footer>
  <div class="credit">
    <span>Owned and maintained by Pysgod Interactive</span>
    <Fragment set:html={pysgodMarkMuted} />
  </div>
  <div class="inner">
    <span>&copy; {year} EpicToolsOnline</span>
    <div class="links">
    </div>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .credit {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-4) 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: center;
  }

  .credit :global(svg) {
    display: block;
    width: 96px;
    height: auto;
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .links {
    display: flex;
    gap: var(--space-4);
  }

  footer a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  footer a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
</style>
